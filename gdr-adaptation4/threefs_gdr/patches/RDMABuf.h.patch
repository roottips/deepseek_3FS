/**
 * =========================================================================
 * Patch:  src/common/net/ib/RDMABuf.h
 * Purpose: Extend RDMABuf::Inner to detect GPU memory pointers and register
 *          them via the GDR-aware cache (nvidia-peermem or dma-buf).
 *
 * Baseline: 3FS commit f84e609692dded708f9c910caf5c5af3444e1024
 *
 * Context
 * -------
 * In the baseline, RDMABuf::Inner has:
 *   * mrs_  : std::array<ibv_mr*, IBDevice::kMaxDeviceCnt> (one MR per device)
 *   * registerMemory() : no args, iterates IBDevice::all(), calls
 *                        dev->regMemory(ptr_, capacity_, kAccessFlags)
 *   * getMR(dev)       : returns mrs_.at(dev)
 *   * getRkeys()       : builds rkey array from mrs_
 *   * ~Inner()         : iterates IBDevice::all(), calls dev->deregMemory(mr)
 *
 * With GDR, the user may pass a GPU device pointer (VMM-mapped VA).
 * The baseline registerMemory() would either fail or skip SYNC_MEMOPS.
 *
 * This patch:
 *   * Adds gpu_handles_ array (parallel to mrs_) to cache GpuMrHandle per
 *     device. When non-null, the corresponding mrs_ entry is adopted from
 *     the cache (we do NOT own its lifetime).
 *   * Adds gpu_backed_ flag so ~Inner() knows to release cache refs
 *     instead of calling dev->deregMemory().
 *   * Adds detectGpuPointer_() helper.
 *
 * Design: the existing getMR()/getRkeys() code works unchanged because we
 * store the cache's ibv_mr* into mrs_[] — the GpuMrHandle->mr pointer is
 * the same underlying verbs MR.
 * =========================================================================
 */

--- a/src/common/net/ib/RDMABuf.h
+++ b/src/common/net/ib/RDMABuf.h
@@ -22,6 +22,8 @@
 #include <folly/logging/xlog.h>
 #include <gtest/gtest_prod.h>
 #include <infiniband/verbs.h>
+#include <memory>  // for std::shared_ptr (GpuMrHandle forward-declared)
 #include <map>

 #include "common/net/ib/IBDevice.h"
@@ -36,6 +38,11 @@ namespace hf3fs::net {

 using RDMABufMR = ibv_mr *;

+// GDR: forward-declare GPU MR handle from GpuMemMgr.h (avoid pulling
+// cuda.h into every translation unit that includes RDMABuf.h).
+struct GpuMrHandle;
+using GpuMrHandlePtr = std::shared_ptr<GpuMrHandle>;
+
 class RDMABufPool;

 class RDMABuf {
@@ -241,6 +248,8 @@ class RDMABuf : public Noncopyable {
     int allocateMemory();
     int registerMemory();

+    bool detectGpuPointer_();
+
     RDMABufMR getMR(int dev) const;
     bool getRkeys(std::array<RDMARemoteBuf::Rkey, IBDevice::kMaxDeviceCnt> &rkeys) const;
@@ -286,6 +295,12 @@ class RDMABuf : public Noncopyable {
     std::array<RDMABufMR, IBDevice::kMaxDeviceCnt> mrs_;
     bool userBuffer_;
+    // GDR: per-device cached GPU MR handle. When non-null, the
+    // corresponding mrs_[devId] is adopted from the GpuMrCache and
+    // must NOT be deregistered via dev->deregMemory(); instead we
+    // release the shared_ptr which decrements the cache refcount.
+    std::array<GpuMrHandlePtr, IBDevice::kMaxDeviceCnt> gpu_handles_;
+    bool gpu_backed_{false};
   };
