/**
 * =========================================================================
 * Patch:  src/lib/common/Shm.cc + src/lib/common/Shm.h
 * Purpose: Add GPU-memory allocation mode to ShmBuf so the USRBIO iov
 *          ring can be backed by GPU device memory (via CUDA VMM API).
 *
 * Baseline: 3FS commit f84e609692dded708f9c910caf5c5af3444e1024
 *
 * Context
 * -------
 * Baseline ShmBuf (namespace hf3fs::lib, struct):
 *   * bufStart : uint8_t*  (public, line 42)
 *   * size     : size_t    (public, line 43)
 *   * blockSize: size_t    (public, line 44)
 *   * path     : Path      (public, line 41)
 *   * owner_   : bool      (private, line 68)
 *   * mapBuf() : private, line 149
 *     -> shm_open(path.c_str(), O_RDWR | (owner_ ? O_CREAT|O_EXCL : 0), 0666)
 *     -> mmap(nullptr, size, PROT_READ|PROT_WRITE, MAP_SHARED, fd, off)
 *   * unmapBuf(): line 128
 *     -> munmap(bufStart, size); if (owner_) shm_unlink(path.c_str());
 *   * registerForIO(): iterates blockSize segments, calls
 *     sc.registerIOBuffer(bufStart + blockSize*i, ...) (line 103)
 *
 * Data path without GDR:
 *   SSD -> [storage RDMA-WRITE] -> Iov host memory -> user app cudaMemcpy -> GPU
 *
 * With GDR:
 *   SSD -> [storage RDMA-WRITE] -> Iov GPU memory  (no copy)
 *
 * This patch:
 *   1. Adds HF3FS_IOV_USE_GPU_MEMORY env flag; when set, mapBuf() calls
 *      mapBufGpu_() instead of shm_open+mmap.
 *   2. mapBufGpu_() allocates via GpuMemMgr::vmmAlloc() (CUDA VMM API:
 *      cuMemAddressReserve/cuMemCreate/cuMemMap/cuMemSetAccess).
 *   3. unmapBufGpu_() drops the shared_ptr<GpuVmmAllocation> which
 *      triggers RAII teardown.
 *   4. registerForIO() works unchanged because it passes bufStart to
 *      sc.registerIOBuffer(), which eventually hits RDMABuf::Inner::
 *      registerMemory() — already patched to detect GPU pointers.
 * =========================================================================
 */

--- a/src/lib/common/Shm.cc
+++ b/src/lib/common/Shm.cc
@@ -1,6 +1,9 @@
 #include "Shm.h"

 #include <fcntl.h>
+#include <cstdlib>
 #include <folly/experimental/coro/BlockingWait.h>
 #include <numa.h>
 #include <sys/mman.h>
 #include <unistd.h>

+#include "common/net/ib/GpuMemMgr.h"
+
 namespace hf3fs::lib {
+
+// GDR config flags (env-overridable; see hf3fs/docs/USRBIO.md).
+static bool s_use_gpu_memory = [] {
+  const char *e = std::getenv("HF3FS_IOV_USE_GPU_MEMORY");
+  return e != nullptr && std::string(e) == "1";
+}();
+static size_t s_gpu_device_id = [] {
+  const char *e = std::getenv("HF3FS_IOV_GPU_DEVICE_ID");
+  return e ? std::stoul(e) : 0;
+}();
+
 ShmBuf::ShmBuf(const Path &p, size_t sz, size_t bsz, int numa, meta::Uid u, int pr, int pp)
@@ -128,6 +137,12 @@ void ShmBuf::unmapBuf() {
 void ShmBuf::unmapBuf() {
+  if (is_gpu_backed_) {
+    return unmapBufGpu_();
+  }
   if (bufStart) {
     munmap(bufStart, size);

     if (owner_) {
@@ -149,6 +164,11 @@ void ShmBuf::mapBuf() {
 void ShmBuf::mapBuf() {
+  if (s_use_gpu_memory) {
+    return mapBufGpu_();
+  }
   auto fd = shm_open(path.c_str(), O_RDWR | (owner_ ? O_CREAT | O_EXCL : 0), 0666);
   if (fd < 0) {
     auto err = errno;
@@ -175,3 +195,49 @@ void ShmBuf::mapBuf() {
   XLOGF(DBG, "this {} owner {} buf start {} size {} off {}", (void *)this, owner_, (void *)bufStart, size, off);
 }
+
+// ---- NEW: GPU-backed mapBuf (CUDA VMM API) ---------------------------
+//
+// Allocates the whole iov ring as a single VMM region on the target GPU:
+//   cuMemAddressReserve -> cuMemCreate -> cuMemMap -> cuMemSetAccess
+// via hf3fs::net::GpuMemMgr::vmmAlloc(). The returned GpuVmmAllocation
+// is RAII: dropping the shared_ptr reverses the mapping.
+
+void ShmBuf::mapBufGpu_() {
+  using namespace hf3fs::net;
+
+  if (!GpuMemMgr::probe()) {
+    throw std::runtime_error(
+        "HF3FS_IOV_USE_GPU_MEMORY=1 but CUDA is unavailable");
+  }
+
+  // VMM allocation with IPC fd export so a different process (the user
+  // application) can import the same physical allocation.
+  vmm_alloc_ = GpuMemMgr::vmmAlloc(
+      size, static_cast<int>(s_gpu_device_id), /*export_ipc=*/true);
+  if (!vmm_alloc_ || !vmm_alloc_->valid()) {
+    throw std::runtime_error(
+        "GpuMemMgr::vmmAlloc failed for USRBIO iov ring "
+        "(cuMemAddressReserve/cuMemCreate/cuMemMap)");
+  }
+
+  // Point bufStart at the VMM-mapped device VA so the rest of ShmBuf's
+  // existing I/O path (registerForIO, memh, ShmBufForIO::ptr) works
+  // unchanged.
+  bufStart = reinterpret_cast<uint8_t *>(vmm_alloc_->va);
+  is_gpu_backed_ = true;
+
+  XLOGF(DBG, "ShmBuf GPU-backed (VMM), bufStart {} size {} dev {}",
+        (void *)bufStart, size, s_gpu_device_id);
+}
+
+void ShmBuf::unmapBufGpu_() {
+  if (vmm_alloc_) {
+    // RAII: dropping the shared_ptr runs GpuVmmAllocation::destroy()
+    // which reverses the VMM mapping in order:
+    //   cuMemUnmap -> cuMemRelease -> cuMemAddressFree
+    vmm_alloc_.reset();
+    bufStart = nullptr;
+    is_gpu_backed_ = false;
+  }
+}
+
 }  // namespace hf3fs::lib

