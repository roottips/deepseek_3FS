+namespace hf3fs::net { struct GpuVmmAllocation; }
+
 #include "PerProcTable.h"
@@ -64,6 +68,12 @@ struct ShmBuf {
  private:
   void mapBuf();
+  void mapBufGpu_();       // GDR: VMM-backed allocation path
+  void unmapBufGpu_();     // GDR: RAII teardown of the VMM region
+  // GDR: owns the VMM allocation. RAII; reset() tears down the mapping.
+  std::shared_ptr<hf3fs::net::GpuVmmAllocation> vmm_alloc_;
+  bool is_gpu_backed_{false};

  private:
   bool owner_;
@@ -73,6 +83,16 @@ struct ShmBuf {
   std::atomic<bool> regging_;
 };
+
+ public:
+  // GDR: return the CUDA device pointer for GPU-backed iovs. Returns
+  // nullptr when host-backed (caller falls back to host + cudaMemcpy).
+  void *gpuPtr() const { return is_gpu_backed_ ? bufStart : nullptr; }
+  bool isGpuBacked() const { return is_gpu_backed_; }
+  // GDR: POSIX fd IPC handle for cross-process sharing of the VMM
+  // allocation. -1 when not GPU-backed or export failed.
+  int ipcFd() const {
+    return (is_gpu_backed_ && vmm_alloc_) ? vmm_alloc_->ipc_fd : -1;
+  }
 };

