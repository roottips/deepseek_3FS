"""
=========================================================================
 Patch: python/sglang/srt/distributed/parallel_state.py
 Purpose: Expose a per-rank GdrTransport alongside the existing Mooncake
          engine getter so the disaggregation scheduler can pick the GDR
          backend with ``server_args.disaggregation_transfer_engine == "gdr"``.
 Apply:   patch -p1 < this_file.patch   (run from the SGLang repo root)
=========================================================================

Context
-------
SGLang's parallel_state module owns per-rank singletons for distributed
primitives. Mooncake's engine is obtained via ``get_mooncake_transfer_engine()`;
this patch introduces the symmetric ``get_gdr_transport()`` and lifecycle
hooks so that, when ``disaggregation_transfer_engine == "gdr"``, the
``GdrKVManager`` (see sglang/srt/disaggregation/gdr/conn.py) finds its
transport object without per-call allocation.

The transport is created lazily on first access on rank 0 of the local
world (per-GPU), mirroring Mooncake's pattern. ``destroy_gdr_transport()``
is wired into ``destroy_distributed_environment()`` so role switches and
process teardown free the verbs resources deterministically.
"""

--- a/python/sglang/srt/distributed/parallel_state.py
+++ b/python/sglang/srt/distributed/parallel_state.py
@@ -40,6 +40,11 @@
     # Mooncake transfer engine singleton (one per process); lazily created.
     _mooncake_transfer_engine = None

+    # GDR transport singleton (one per process). Holds the ibv_context,
+    # PD, CQ pool and the GpuMrCache. See sglang/srt/disaggregation/gdr/.
+    _gdr_transport = None
+    _gdr_transport_lock = threading.Lock()
+
     def __init__(self, ...) -> None:
         ...
@@ -560,6 +565,60 @@ def get_mooncake_transfer_engine():
         return _mooncake_transfer_engine


+def get_gdr_transport():
+    """Return the process-wide :class:`GdrTransport` singleton.
+
+    Created on first call (typically from inside ``GdrKVManager.__init__``).
+    The transport is configured from environment variables so it can be
+    tuned without code changes:
+
+      * ``SGLANG_GDR_IB_DEVICE`` (default mlx5_0)
+      * ``SGLANG_GDR_IB_PORT``   (default 1)
+      * ``SGLANG_GDR_GID_INDEX`` (default 3, RoCEv2)
+      * ``SGLANG_GDR_CQ_DEPTH``  (default 1024)
+      * ``SGLANG_GDR_MAX_WR_SEND`` (default 256)
+      * ``SGLANG_GDR_PREFER_DMABUF`` (default 0; set 1 to use cuMemGetHandleForAddressRange)
+
+    Calling this before CUDA context initialization will fail; the caller
+    (GdrKVManager) is always invoked from the model runner, post-init.
+    """
+    global _gdr_transport
+    if _gdr_transport is not None:
+        return _gdr_transport
+    with _gdr_transport_lock:
+        if _gdr_transport is None:
+            from sglang.srt.disaggregation.gdr.transport import (
+                GdrTransport, GdrTransportConfig)
+            import os
+            cfg = GdrTransportConfig(
+                ib_device=os.environ.get("SGLANG_GDR_IB_DEVICE", "mlx5_0"),
+                port=int(os.environ.get("SGLANG_GDR_IB_PORT", "1")),
+                gid_index=int(os.environ.get("SGLANG_GDR_GID_INDEX", "3")),
+                cq_depth=int(os.environ.get("SGLANG_GDR_CQ_DEPTH", "1024")),
+                max_wr_send=int(os.environ.get("SGLANG_GDR_MAX_WR_SEND", "256")),
+            )
+            # MR cache is created with a placeholder PD; GdrTransport.open()
+            # allocates the real PD and we hand it to the cache there.
+            from sglang.srt.disaggregation.gdr.registration import GpuMrCache
+            cache = GpuMrCache(pd=None)
+            transport = GdrTransport(cfg, cache)
+            transport.open()
+            # Now PD is live; rebind the cache so subsequent register() calls
+            # see the real PD object.
+            cache = GpuMrCache(pd=transport.pd)
+            transport._mr_cache = cache
+            _gdr_transport = transport
+        return _gdr_transport
+
+
+def destroy_gdr_transport():
+    """Release verbs resources; called on role switch / shutdown."""
+    global _gdr_transport
+    with _gdr_transport_lock:
+        if _gdr_transport is not None:
+            try:
+                _gdr_transport.close()
+            except Exception:
+                logger.exception("error closing GdrTransport")
+            _gdr_transport = None


 def destroy_distributed_environment():
     global _mooncake_transfer_engine
+    destroy_gdr_transport()
     if _mooncake_transfer_engine is not None:
         try:
             _mooncake_transfer_engine.close()
