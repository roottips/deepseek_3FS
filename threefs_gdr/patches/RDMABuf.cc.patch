/**
 * =========================================================================
 * Patch:  src/common/net/ib/RDMABuf.cc
 * Purpose: Implement GPU-aware memory registration for RDMABuf::Inner.
 *          When a user buffer turns out to be a CUDA device pointer,
 *          registration goes through GpuMemMgr (peermem or dma-buf)
 *          instead of the bare ibv_reg_mr host-memory path.
 * =========================================================================

Context
-------
Original RDMABuf::Inner::registerMemory() calls
``dev->regMemory(ptr_, capacity_, accessFlags_)`` unconditionally. With
nvidia-peermem loaded this technically succeeds for GPU pointers but
silently skips the mandatory cuPointerSetAttribute(SYNC_MEMOPS=1) call,
causing consumer-side data corruption.

This patch:
  * Adds Inner::detectGpuPointer_() which queries
    GpuMemMgr::isDevicePointer().
  * Reworks registerMemory() to:
      if (host):  existing ibv_reg_mr path
      if (gpu):   GpuMemMgr::cacheFor(dev)->registerRegion()
                  (which sets SYNC_MEMOPS, picks peermem/dmabuf,
                   caches the MR, refcounts it).
  * Adds sge()/remoteAddrRkey() that use the GpuMrHandle's device VA
    rather than mr_->addr for GPU memory.
  * Adds deregisterMemory() path that releases the shared_ptr to the
    cache entry; the actual ibv_dereg_mr is left to the LRU cache so
    repeated transfers do not pay re-pin cost.
*/

--- a/src/common/net/ib/RDMABuf.cc
+++ b/src/common/net/ib/RDMABuf.cc
@@ -18,6 +18,7 @@
 #include "RDMABuf.h"

 #include "IBDevice.h"
+#include "GpuMemMgr.h"

 namespace hf3fs::net::ib {

@@ -45,7 +46,28 @@ bool RDMABuf::Inner::detectGpuPointer_() {
+  // Lazy-init GDR subsystem; if CUDA is unavailable, isDevicePointer
+  // returns false and we fall back to the host-memory path.
+  if (!GpuMemMgr::probe()) {
+    return false;
+  }
+  return GpuMemMgr::isDevicePointer(ptr_);
+}

-void RDMABuf::Inner::registerMemory() {
+void RDMABuf::Inner::registerMemory(IBDevice *device) {
+  device_ = device;  // stash so deregisterMemory() can reach the cache
+  if (detectGpuPointer_()) {
+    auto &cache = GpuMemMgr::instance().cacheFor(device);
+    gpu_handle_ = cache.registerRegion(ptr_, capacity_);
+    if (gpu_handle_) {
+      // Adopt the verbs MR handle from the cache; we do NOT free it
+      // here on deregister -- the cache owns its lifetime.
+      mr_ = gpu_handle_->mr;
+      kind_ = (gpu_handle_->kind == GpuMrHandle::Kind::DMABUF)
+                  ? MemoryKind::GPU_DMABUF
+                  : MemoryKind::GPU_PEERMEM;
+      return;
+    }
+    // Pin failed (BAR1 exhausted or peermem missing); fall through and
+    // attempt the host path, which will likely fail loudly.
+  }
+  // Host-memory path: the original implementation.
   mr_ = device->regMemory(ptr_, capacity_, accessFlags_);
   kind_ = MemoryKind::HOST;
 }

 void RDMABuf::Inner::deregisterMemory() {
+  if (gpu_handle_) {
+    // Release our refcount; the cache's LRU owns the actual MR.
+    GpuMemMgr::instance().cacheFor(device_).release(gpu_handle_);
+    gpu_handle_.reset();
+    mr_ = nullptr;
+    return;
+  }
   if (mr_) {
     ibv_dereg_mr(mr_);
     mr_ = nullptr;
   }
 }

+ibv_sge RDMABuf::sge(size_t length, size_t offset) const {
+  ibv_sge sge{};
+  if (inner_.gpu_handle_) {
+    // Device VA-based SGE; mr_->addr is meaningless for dma-buf MRs.
+    sge.addr = reinterpret_cast<uint64_t>(inner_.gpu_handle_->addr) + offset;
+    sge.length = length;
+    sge.lkey = inner_.gpu_handle_->lkey;
+  } else {
+    sge.addr = reinterpret_cast<uint64_t>(inner_.ptr_) + offset;
+    sge.length = length;
+    sge.lkey = inner_.mr_ ? inner_.mr_->lkey : 0;
+  }
+  return sge;
+}
+
+std::pair<uint64_t, uint32_t> RDMABuf::remoteAddrRkey() const {
+  if (inner_.gpu_handle_) {
+    return {reinterpret_cast<uint64_t>(inner_.gpu_handle_->addr),
+            inner_.gpu_handle_->rkey};
+  }
+  return {reinterpret_cast<uint64_t>(inner_.mr_->addr), inner_.mr_->rkey};
+}
