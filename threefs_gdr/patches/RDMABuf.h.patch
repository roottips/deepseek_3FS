/**
 * =========================================================================
 * Patch:  src/common/net/ib/RDMABuf.h
 * Purpose: Extend RDMABuf to detect GPU memory pointers and register them
 *          via the GDR-aware path (nvidia-peermem or dma-buf). Without
 *          this patch, RDMABuf::createFromUserBuffer() calls ibv_reg_mr()
 *          directly, which fails on GPU pointers when peermem is not loaded
 *          and silently mis-registers them when it is (no SYNC_MEMOPS set).
 * =========================================================================

Context
-------
3FS's RDMABuf has two construction paths:

  1. RDMABuf::allocate(nbytes)
     - allocMemory() via hf3fs::memory::memalign (host)
     - registerMemory() calls dev->regMemory(ptr, len, kAccessFlags)

  2. RDMABuf::createFromUserBuffer(buf, len)
     - assumes the caller already owns the buffer; same registerMemory()

Both paths set ``userBuffer_=true`` in case 2. With GDR, the caller may
pass a GPU pointer (cudaMalloc'd, or a cuMemAlloc'd VMM region). The
existing registerMemory() would either fail or skip the SYNC_MEMOPS
attribute, which can corrupt data on the consumer side.

This patch:
  * Adds a ``MemoryKind`` enum to RDMABuf::Inner so the buffer knows
    whether it's host or GPU memory.
  * Routes registerMemory() through GpuMemMgr::instance().cacheFor(dev)
    when the pointer is detected as device memory.
  * Exposes ``isGpuMemory()``, ``gpuHandle()``, and ``sge()`` that
    return the device-VA-based SGE that peers must target.
*/

--- a/src/common/net/ib/RDMABuf.h
+++ b/src/common/net/ib/RDMABuf.h
@@ -32,6 +32,11 @@ namespace hf3fs::net::ib {

 constexpr int kAccessFlags =
     IBV_ACCESS_LOCAL_WRITE | IBV_ACCESS_REMOTE_WRITE | IBV_ACCESS_REMOTE_READ | IBV_ACCESS_RELAXED_ORDERING;
+
+// Forward declaration for the GPU-memory-aware cache defined in GpuMemMgr.h.
+class GpuMemMgr;
+struct GpuMrHandle;
+using GpuMrHandlePtr = std::shared_ptr<GpuMrHandle>;

 class RDMABuf : public Noncopyable {
  public:
@@ -44,6 +49,16 @@ class RDMABuf : public Noncopyable {
   // Storage backing mode.
   enum class MemoryKind : uint8_t {
     HOST = 0,    // malloc'd/mmap'd host RAM
+    GPU_PEERMEM = 1,  // cudaMalloc'd; ibv_reg_mr on device VA (peermem)
+    GPU_DMABUF = 2,   // dma-buf fd path (CUDA 13+)
   };

   // Wraps the verbs MR + access flags + the source buffer.
@@ -62,8 +77,18 @@ class RDMABuf : public Noncopyable {
     int accessFlags_{kAccessFlags};
     bool userBuffer_{false};
     MemoryKind kind_{MemoryKind::HOST};
+    // Cached GPU MR handle from GpuMemMgr::cacheFor(); non-null only
+    // when kind_ is GPU_PEERMEM or GPU_DMABUF. Keeping a shared_ptr
+    // keeps the underlying ibv_mr alive until we deregister.
+    GpuMrHandlePtr gpu_handle_;
+    // IBDevice that owns the MR; stored on registerMemory() so
+    // deregisterMemory() can hand it back to the GpuMrCache without an
+    // extra parameter. (Inner is a nested class and does NOT have
+    // access to RDMABuf::device_.)
+    IBDevice *device_{nullptr};
+
+    // Detect whether ``ptr_`` is a CUDA device pointer. Called from
+    // registerMemory() so callers don't have to know the kind up front.
+    bool detectGpuPointer_();

    public:
     Inner(void *buf, size_t len) : ptr_(buf), capacity_(len) {}
+
+    // Override of registerMemory() that picks the right GDR/host path.
+    // device is stashed in device_ so deregisterMemory() can reach the
+    // same GpuMrCache without re-passing it.
+    void registerMemory(IBDevice *device);
     void deregisterMemory();

@@ -123,6 +148,19 @@ class RDMABuf : public Noncopyable {
   // Build the verbs SGE for the source buffer. For GPU memory the SGE
   // must use the device VA (the GpuMrHandle->addr), NOT mr->addr which
   // is meaningless for dma-buf MRs.
   ibv_sge sge(size_t length, size_t offset = 0) const;
+
+  // True when the underlying buffer lives in GPU device memory.
+  bool isGpuMemory() const { return inner_.kind_ != MemoryKind::HOST; }
+  MemoryKind memoryKind() const { return inner_.kind_; }
+  const GpuMrHandlePtr &gpuHandle() const { return inner_.gpu_handle_; }
+
+  // Advertise (remote_addr, rkey) pair that peers must use to RDMA-WRITE
+  // into this buffer. For host memory this is mr_->addr + rkey; for GPU
+  // memory this is gpu_handle_->addr + rkey (mr_->addr is meaningless
+  // for dma-buf MRs).
+  std::pair<uint64_t, uint32_t> remoteAddrRkey() const;
+
  private:
   Inner inner_;
   IBDevice *device_{nullptr};
 };
